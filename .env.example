# Copia este archivo como .env, rellena los valores y súbelo al ESP32:
#   mpremote connect /dev/ttyUSB0 cp .env :.env
# El .env real NUNCA se commitea (está en .gitignore).
# Formato: CLAVE=valor, una por línea. Las comillas son opcionales.

# --- Wi-Fi ---
WIFI_SSID=TU_SSID
WIFI_PASSWORD=TU_PASSWORD

# --- Servidor Proxmox ---
PROXMOX_HOST=192.168.1.50
PROXMOX_PORT=8006

# --- Telegram ---
TELEGRAM_TOKEN=TU_BOT_TOKEN
TELEGRAM_CHAT_ID=TU_CHAT_ID

# --- Ajustes opcionales (descomenta para cambiar el valor por defecto) ---
# CHECK_INTERVAL=30      # segundos entre chequeos
# FAIL_THRESHOLD=3       # fallos consecutivos antes de alertar
# ALERT_COOLDOWN=600     # segundos entre recordatorios mientras siga caido
# REQUEST_TIMEOUT=10     # timeout de red en segundos
# WEB_PORT=80            # puerto del dashboard
